# === Envoi des e-mails (boîte OVH sales@guedsonandcointertrade.com) ===
SMTP_HOST=smtp.mail.ovh.net
SMTP_PORT=465
SMTP_ENCRYPTION=ssl
SMTP_USERNAME=sales@guedsonandcointertrade.com
SMTP_PASSWORD=mot-de-passe-de-la-boite-mail
MAIL_FROM_EMAIL=sales@guedsonandcointertrade.com
MAIL_FROM_NAME=Site Guedson & Co
MAIL_TO_EMAIL=sales@guedsonandcointertrade.com
MAIL_TO_NAME=Guedson & Co

# IMAP (réception / consultation de la boîte, non utilisé par l'envoi du formulaire)
# IMAP_HOST=imap.mail.ovh.net
# IMAP_PORT=993

# === CORS (production) ===
# Origines autorisées à appeler l'API : le domaine du site, avec ET sans www.
CORS_ALLOWED_ORIGINS=https://guedsonandcointertrade.com,https://www.guedsonandcointertrade.com
# En production : 0 (n'autoriser que les origines ci-dessus).
# En dev local : 1 (autorise automatiquement http(s)://localhost:* et 127.0.0.1:*).
CORS_ALLOW_ANY_LOCALHOST=0
